# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Use static frameworks - required for Firebase Swift pods to generate proper headers
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true

# Fix for AppLovin + react-native-video AVFoundation factory conflict
install! 'cocoapods', :deterministic_uuids => false

# react-native-permissions configuration
# Only include the permissions you need to reduce app size
def node_require(script)
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve('#{script}', {paths: [process.argv[1]]})", __dir__]).strip
end

node_require('react-native-permissions/scripts/setup.rb')

setup_permissions([
  'Camera',
  'PhotoLibrary',
])

target 'CosmicMarkcon' do
  config = use_native_modules!
  
  # Enable modular headers for Firebase dependencies that require it
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  pod 'FirebaseInstallations', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true
  pod 'nanopb', :modular_headers => true
  pod 'FirebaseABTesting', :modular_headers => true
  pod 'FirebaseRemoteConfig', :modular_headers => true
  pod 'FirebaseAuthInterop', :modular_headers => true
  pod 'FirebaseAppCheckInterop', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true

  # ========================================
  # AppLovin Mediation Adapters
  # ========================================
  # IMPORTANT: Some adapters are commented out due to conflicts with react-native-video
  # 
  # ISSUE: IronSource, Vungle, Mintegral, and Fyber adapters include their own video 
  # players for video ads. These register AVFoundation component factories that conflict 
  # with react-native-video, causing this crash at runtime:
  #   "AddInstanceForFactory: No factory registered for id F8BB1C28-BAE8-11D6-9C31-00039315CD46"
  #
  # SAFE ADAPTERS (kept with modular headers isolation):
  pod 'AppLovinMediationGoogleAdapter', :modular_headers => true  # ✅ Compatible
  pod 'AppLovinMediationUnityAdsAdapter', :modular_headers => true  # ✅ Compatible
  
  # CONFLICTING ADAPTERS (contain video ad players that interfere with react-native-video):
  # If you need these, test them individually with video playback to verify compatibility
  # pod 'AppLovinMediationIronSourceAdapter'   # ❌ Contains IronSource video player
  # pod 'AppLovinMediationVungleAdapter'       # ❌ Video-focused ad network
  # pod 'AppLovinMediationMintegralAdapter'    # ❌ Heavy video ad components
  # pod 'AppLovinMediationFyberAdapter'        # ❌ Video ad capabilities
  
  # Not currently needed:
  # pod 'AppLovinMediationFacebookAdapter'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    
    # Exclude x86_64 architecture for Apple Silicon Macs (required for AppsFlyer)
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'x86_64'
        
        # Force dSYM generation for all pods
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
        config.build_settings['GENERATE_DSYM'] = 'YES'
        
        # FIX: Enable modular headers for AppLovin adapters to prevent video factory conflicts
        if target.name.start_with?('AppLovinMediation') || target.name == 'AppLovinSDK'
          config.build_settings['DEFINES_MODULE'] = 'YES'
          config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
          config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
        end
        
        # FIX: Ensure react-native-video has priority for AVFoundation components
        if target.name == 'react-native-video'
          config.build_settings['DEFINES_MODULE'] = 'YES'
          config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
          config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
          # Give video library highest priority
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'RN_VIDEO_HAS_PRIORITY=1'
        end
        
        # Additional isolation for video ad SDKs
        if target.name.include?('IronSource') || target.name.include?('Vungle') || 
           target.name.include?('Mintegral') || target.name.include?('Fyber')
          config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
          config.build_settings['DEFINES_MODULE'] = 'YES'
        end
        
        # Fixes for AppLovin and related frameworks
        if target.name.include?('AppLovin')
          config.build_settings['STRIP_INSTALLED_PRODUCT'] = 'NO'
          config.build_settings['COPY_PHASE_STRIP'] = 'NO'
        end
        
        # Fix for Facebook Audience Network Swift runtime issue
        if target.name.include?('FBAudienceNetwork') || target.name.include?('FBSDKCoreKit')
          config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = 'YES'
          config.build_settings['LD_RUNPATH_SEARCH_PATHS'] = ['$(inherited)', '@executable_path/Frameworks', '@loader_path/Frameworks']
          config.build_settings['LIBRARY_SEARCH_PATHS'] = ['$(inherited)', '$(SDKROOT)/usr/lib/swift', '$(TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)']
        end
      end
    end
  end
end