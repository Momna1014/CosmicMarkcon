# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# react-native-permissions: opt-in to specific permission handlers
require_relative '../node_modules/react-native-permissions/scripts/setup'
setup_permissions([
  'Camera',
  'PhotoLibrary',
])

# Firebase 12.x ships FirebaseAuth as a Swift module. The umbrella `Firebase.h`
# imports `FirebaseAuth-Swift.h`, which is only generated when pods are built as
# frameworks. Default to static frameworks so the Swift header is produced and
# discoverable by Obj-C consumers (RNFBAuth/Messaging/RemoteConfig, etc.).
ENV['USE_FRAMEWORKS'] ||= 'static'

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
  
end

target 'Cosmiq' do
  config = use_native_modules!
  
  # @feature:firebase-remote-config:start
  # Enable modular headers for Firebase dependencies that require it
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  pod 'FirebaseInstallations', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true
  pod 'nanopb', :modular_headers => true
  pod 'FirebaseABTesting', :modular_headers => true
  pod 'FirebaseAuth', :modular_headers => true        # ← add this
  pod 'GTMSessionFetcher', :modular_headers => true   # ← add this
  pod 'FirebaseRemoteConfig', :modular_headers => true
  pod 'FirebaseAuthInterop', :modular_headers => true
  pod 'FirebaseAppCheckInterop', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true
  # @feature:firebase-remote-config:end

  # @feature:applovin-max:start [disabled]
  # # ========================================
  # # AppLovin Mediation Adapters
  # # ========================================
  # # Temporarily disabled Facebook adapter due to iOS build issues (FBAudienceNetwork bundle)
  # # pod 'AppLovinMediationFacebookAdapter'
  # pod 'AppLovinMediationGoogleAdapter'
  # pod 'AppLovinMediationUnityAdsAdapter'
  # pod 'AppLovinMediationIronSourceAdapter'
  # pod 'AppLovinMediationVungleAdapter'
  # pod 'AppLovinMediationMintegralAdapter'
  # pod 'AppLovinMediationFyberAdapter'
  # @feature:applovin-max:end

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    
    # Exclude x86_64 architecture for Apple Silicon Macs
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'x86_64'
        
        # Force dSYM generation for all pods
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
        config.build_settings['GENERATE_DSYM'] = 'YES'
        
        # Fixes for AppLovin and related frameworks
        if target.name.include?('AppLovin')
          config.build_settings['STRIP_INSTALLED_PRODUCT'] = 'NO'
          config.build_settings['COPY_PHASE_STRIP'] = 'NO'
        end
        
        # Fix for Facebook Audience Network Swift runtime issue
        if target.name.include?('FBAudienceNetwork') || target.name.include?('FBSDKCoreKit')
          config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = 'YES'
          config.build_settings['LD_RUNPATH_SEARCH_PATHS'] = ['$(inherited)', '@executable_path/Frameworks', '@loader_path/Frameworks']
          config.build_settings['LIBRARY_SEARCH_PATHS'] = ['$(inherited)', '$(SDKROOT)/usr/lib/swift', '$(TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)']
        end
      end
    end
  end
end
